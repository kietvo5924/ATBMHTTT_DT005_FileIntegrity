        <!-- TIÊU ĐỀ CHÍNH -->
        <mxCell id="title" value="KIẾN TRÚC DIỄN TẬP ĐỐI KHÁNG: BLUE TEAM (PORT 8080)  vs  RED TEAM (PORT 8081)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="1000" height="35" as="geometry" />
        </mxCell>

        <!-- BLUE TEAM -->
        <mxCell id="box_blue" value="BLUE TEAM — PHÒNG THỦ &amp; GIÁM SÁT (PORT 8080)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#1e3a8a;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="50" y="70" width="480" height="420" as="geometry" />
        </mxCell>

        <mxCell id="b_ds" value="&lt;b&gt;Tập Dữ Liệu&lt;/b&gt;&lt;br&gt;kaggle_dataset&lt;br&gt;(2.483 tệp / 112 MB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;" vertex="1" parent="box_blue">
          <mxGeometry x="25" y="60" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="b_eng" value="&lt;b&gt;Động Cơ Toàn Vẹn&lt;/b&gt;&lt;br&gt;SHA-256 / HMAC / HD-Merkle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1d4ed8;strokeWidth=1.5;fontSize=11;fontColor=#1e3a8a;" vertex="1" parent="box_blue">
          <mxGeometry x="260" y="60" width="195" height="60" as="geometry" />
        </mxCell>

        <mxCell id="b_root" value="&lt;b&gt;Mốc Tin Cậy: Root Hash H_0&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#059669&quot;&gt;[Trạng thái: 100% NGUYÊN VẸN]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;fontSize=11.5;fontColor=#064e3b;" vertex="1" parent="box_blue">
          <mxGeometry x="25" y="165" width="430" height="50" as="geometry" />
        </mxCell>

        <mxCell id="b_detect" value="&lt;b&gt;Định Vị Sai Lệch O(log N) — Dirty Path&lt;/b&gt;&lt;br&gt;Bắt quả tang &lt;b&gt;FILE_MODIFIED&lt;/b&gt; trong &lt;b&gt;~1.06 ms&lt;/b&gt; (2.325 tệp/giây)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;strokeWidth=1.5;fontSize=11;fontColor=#881337;" vertex="1" parent="box_blue">
          <mxGeometry x="25" y="255" width="430" height="55" as="geometry" />
        </mxCell>

        <mxCell id="b_points" value="• PPT Adversary: Phát hiện 100/100 phép can thiệp.&lt;br&gt;• RFC 6962: Phân tách miền triệt tiêu va chạm Node-Leaf.&lt;br&gt;• So sánh hằng số thời gian: hmac.compare_digest." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1;fontSize=10.5;fontColor=#334155;align=left;spacingLeft=10;" vertex="1" parent="box_blue">
          <mxGeometry x="25" y="340" width="430" height="60" as="geometry" />
        </mxCell>

        <mxCell id="be1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563eb;strokeWidth=2;" edge="1" parent="box_blue" source="b_ds" target="b_eng"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="be2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1d4ed8;strokeWidth=2;" edge="1" parent="box_blue" source="b_eng" target="b_root"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="be3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#e11d48;strokeWidth=2;" edge="1" parent="box_blue" source="b_root" target="b_detect"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- RED TEAM -->
        <mxCell id="box_red" value="RED TEAM — ĐỘNG CƠ TẤN CÔNG (PORT 8081)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#991b1b;rounded=1;arcSize=6;" vertex="1" parent="1">
