        <mxCell id="re2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#64748b;strokeWidth=1.5;" edge="1" parent="box_red" source="r_vec" target="r_back"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;" edge="1" parent="box_red" source="r_back" target="r_roll"><mxGeometry relative="1" as="geometry" /></mxCell>

