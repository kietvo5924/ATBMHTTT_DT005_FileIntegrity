        </mxCell>

        <mxCell id="r_eng" value="&lt;b&gt;Adversary Engine&lt;/b&gt;&lt;br&gt;Bộ công cụ tấn công đối kháng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b91c1c;strokeWidth=1.5;fontSize=11.5;fontColor=#7f1d1d;" vertex="1" parent="box_red">
          <mxGeometry x="25" y="60" width="430" height="50" as="geometry" />
        </mxCell>

        <mxCell id="r_vec" value="&lt;b&gt;CÁC VECTOR TẤN CÔNG MINH HỌA:&lt;/b&gt;&lt;br&gt;1. Sửa nội dung tệp (In-place Tamper)&lt;br&gt;2. Bù 4 byte GF(2) qua mặt mã CRC32&lt;br&gt;3. Tráo đổi Merkle Proof (Dolev-Yao MitM)&lt;br&gt;4. Chèn Backdoor / Xóa tệp ngẫu nhiên" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#ef4444;strokeWidth=1;fontSize=11;fontColor=#991b1b;align=left;spacingLeft=10;" vertex="1" parent="box_red">
          <mxGeometry x="25" y="145" width="430" height="90" as="geometry" />
        </mxCell>

        <mxCell id="r_back" value="&lt;b&gt;Snapshot Sao Lưu (.adversary_backups/)&lt;/b&gt;&lt;br&gt;Bảo vệ nguyên trạng trước khi thử nghiệm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontSize=11;fontColor=#334155;" vertex="1" parent="box_red">
          <mxGeometry x="25" y="260" width="430" height="45" as="geometry" />
        </mxCell>

        <mxCell id="r_roll" value="&lt;b&gt;PHỤC HỒI NGUYÊN BẢN (ROLLBACK ALL 100%)&lt;/b&gt;&lt;br&gt;Khôi phục hoàn toàn dữ liệu sạch ban đầu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;fontSize=11.5;fontColor=#064e3b;" vertex="1" parent="box_red">
          <mxGeometry x="25" y="335" width="430" height="55" as="geometry" />
        </mxCell>

