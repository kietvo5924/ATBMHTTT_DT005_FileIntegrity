  <diagram id="shannon-model-slide-06" name="Mô hình Shannon vs Mạng Phức Hợp">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="650" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TIÊU ĐỀ CHÍNH -->
        <mxCell id="title" value="MÔ HÌNH SHANNON (1949)  vs  MẠNG XÃ HỘI - KỸ THUẬT PHỨC HỢP (HALPIN 2025)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="1000" height="35" as="geometry" />
        </mxCell>

        <!-- PANEL TRÁI: SHANNON -->
        <mxCell id="box_shannon" value="MÔ HÌNH ĐIỂM - ĐIỂM SHANNON (1949)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#1d4ed8;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="50" y="70" width="480" height="420" as="geometry" />
        </mxCell>

        <mxCell id="s_alice" value="&lt;b&gt;Alice (Sender)&lt;/b&gt;&lt;br&gt;Bản rõ M" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=1.5;fontSize=12;fontColor=#0f172a;" vertex="1" parent="box_shannon">
          <mxGeometry x="25" y="60" width="115" height="55" as="geometry" />
        </mxCell>

        <mxCell id="s_enc" value="&lt;b&gt;Mã hóa Enc&lt;/b&gt;&lt;br&gt;Khóa K" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=1.5;fontSize=11;fontColor=#1e3a8a;" vertex="1" parent="box_shannon">
          <mxGeometry x="180" y="52" width="105" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s_bob" value="&lt;b&gt;Bob (Receiver)&lt;/b&gt;&lt;br&gt;Bản rõ M" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;strokeWidth=1.5;fontSize=12;fontColor=#0f172a;" vertex="1" parent="box_shannon">
          <mxGeometry x="335" y="60" width="115" height="55" as="geometry" />
        </mxCell>

        <mxCell id="s_chan" value="&lt;b&gt;KÊNH TRUYỀN&lt;/b&gt;&lt;br&gt;Bản mã C = Enc(K, M)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1.5;fontSize=11;fontColor=#991b1b;" vertex="1" parent="box_shannon">
          <mxGeometry x="140" y="170" width="190" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s_eve" value="&lt;b&gt;Eve (Passive Eavesdropper)&lt;/b&gt;&lt;br&gt;Nghe lén trên đường truyền" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;strokeWidth=1.5;fontSize=11;fontColor=#7f1d1d;" vertex="1" parent="box_shannon">
          <mxGeometry x="140" y="265" width="190" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s_note" value="• Giả định: Sai lệch do &lt;b&gt;Nhiễu ngẫu nhiên (Noise)&lt;/b&gt;.&lt;br&gt;• Điểm mù: Đối thủ là &lt;b&gt;tác nhân có chủ đích&lt;/b&gt;, không phải nhiễu!&lt;br&gt;• Bỏ qua chi phí lưu trữ khóa, phân phối khóa &amp; triển khai." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=1;fontSize=10.5;fontColor=#92400e;align=left;spacingLeft=10;" vertex="1" parent="box_shannon">
          <mxGeometry x="25" y="340" width="425" height="60" as="geometry" />
        </mxCell>

        <!-- Edges Left -->
        <mxCell id="se1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563eb;strokeWidth=2;" edge="1" parent="box_shannon" source="s_alice" target="s_enc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1d4ed8;strokeWidth=2;" edge="1" parent="box_shannon" source="s_enc" target="s_chan"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;" edge="1" parent="box_shannon" source="s_chan" target="s_bob"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="195" /></Array></mxGeometry></mxCell>
        <mxCell id="se4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b91c1c;strokeWidth=1.5;dashed=1;" edge="1" parent="box_shannon" source="s_chan" target="s_eve"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- PANEL PHẢI: COMPLEX NETWORK -->
        <mxCell id="box_complex" value="MẠNG XÃ HỘI - KỸ THUẬT THỰC TẾ (HALPIN 2025)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#065f46;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="570" y="70" width="480" height="420" as="geometry" />
        </mxCell>

        <mxCell id="c_keepers" value="&lt;b&gt;Secret Keepers&lt;/b&gt;&lt;br&gt;Nhóm giữ bí mật &amp; Policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;strokeWidth=1.5;fontSize=11.5;fontColor=#064e3b;" vertex="1" parent="box_complex">
          <mxGeometry x="25" y="60" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="c_cloud" value="&lt;b&gt;Hạ Tầng Mở / ISP / Cloud&lt;/b&gt;&lt;br&gt;Cáp quang biển &amp; Router" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.5;fontSize=11.5;fontColor=#1e3a8a;" vertex="1" parent="box_complex">
          <mxGeometry x="270" y="60" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="c_nsa" value="&lt;b&gt;ĐỐI THỦ THỂ CHẾ (NSA / STATE ACTORS)&lt;/b&gt;&lt;br&gt;Global Passive &amp; Active Adversary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=1.5;fontSize=11.5;fontColor=#7f1d1d;" vertex="1" parent="box_complex">
          <mxGeometry x="25" y="170" width="425" height="50" as="geometry" />
        </mxCell>

        <mxCell id="c_threats" value="&lt;b&gt;BỐN CON ĐƯỜNG TẤN CÔNG THỰC TẾ:&lt;/b&gt;&lt;br&gt;1. &lt;b&gt;Kênh kề (Side-channel):&lt;/b&gt; Đo thời gian, điện năng, cache.&lt;br&gt;2. &lt;b&gt;Siêu dữ liệu (Metadata):&lt;/b&gt; Lưu lượng, tần suất, kích thước.&lt;br&gt;3. &lt;b&gt;Chuỗi cung ứng:&lt;/b&gt; Cài cửa sau phần cứng (Dual_EC_DRBG).&lt;br&gt;4. &lt;b&gt;Phản bội nội bộ:&lt;/b&gt; Lỗi Byzantine &amp; người trong cuộc (Snowden)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1;fontSize=10.5;fontColor=#991b1b;align=left;spacingLeft=10;" vertex="1" parent="box_complex">
          <mxGeometry x="25" y="260" width="425" height="85" as="geometry" />
        </mxCell>

        <mxCell id="c_foot" value="Mục tiêu mới: &lt;b&gt;Bảo vệ siêu dữ liệu (Mixnet) &amp; Kháng kênh kề&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=2;fontColor=#047857;" vertex="1" parent="box_complex">
          <mxGeometry x="25" y="365" width="425" height="30" as="geometry" />
        </mxCell>

        <!-- Edges Right -->
        <mxCell id="ce1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;" edge="1" parent="box_complex" source="c_keepers" target="c_cloud"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#dc2626;strokeWidth=1.5;dashed=1;" edge="1" parent="box_complex" source="c_nsa" target="c_cloud"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#dc2626;strokeWidth=1.5;dashed=1;" edge="1" parent="box_complex" source="c_nsa" target="c_keepers"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b91c1c;strokeWidth=1.5;" edge="1" parent="box_complex" source="c_nsa" target="c_threats"><mxGeometry relative="1" as="geometry" /></mxCell>

